# Backend Environment Variables

# Server Port
PORT=5000

# Database
MONGODB_URI=your_mongodb_connection_string

# JWT Secret - Change this to a strong secret in production
JWT_SECRET=your_jwt_secret_key

# Allowed Origins for CORS (comma-separated)
# Development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Production - Update with your actual deployed URLs
# ALLOWED_ORIGINS=https://flux-a-flow-frontend.netlify.app,https://flux-a-flow.onrender.com

# Cloudinary (for image uploads)
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service (for sendEmail utility)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_password

# Node Environment
NODE_ENV=development
