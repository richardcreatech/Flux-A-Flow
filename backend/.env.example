# Copy this file to backend/.env and fill in the values.
# Never commit the real .env — it's in .gitignore.

# Server
PORT=5000

# JWT signing secret (rotate before production)
JWT_SECRET=replace-me

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/flux-a-flow

# Gmail SMTP (use an App Password, not your account password)
# https://myaccount.google.com/apppasswords
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=you@gmail.com

# Cloudinary (for profile picture uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
